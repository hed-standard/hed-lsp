# Rebuilt inside the image
**/node_modules
**/out
**/*.tsbuildinfo

# Not needed to build or run the daemon. server/data is kept: the engine reads its embeddings.
.git
.github
docs
scripts

# Local files that must not reach the image: environment files, built extensions, agent and project
# notes, and logs.
.env*
*.vsix
.context
.claude
*.log
