# Rebuilt inside the image
**/node_modules
**/out
**/*.tsbuildinfo

# Not needed to build or run the daemon. server/data is kept: the engine reads its embeddings.
.git
.github
docs
scripts

# Local files that must not reach the image: environment files, built extensions, agent and project
# notes, and logs.
.env*
*.vsix
.context
.claude
*.log

# Saved images: the image job writes hed-lsp-daemon.tar (about 390 MB) to the workspace before it builds the
# second image, and nothing in a build reads a tarball, so it must not be sent into the build context.
*.tar
