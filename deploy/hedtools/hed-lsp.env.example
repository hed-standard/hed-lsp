# Settings of the hed-lsp daemon container on the hedtools host.
#
# Copy this file to ~/hed-lsp-state/hed-lsp.env (mode 600 is a good habit) and edit it there.
# deploy.sh passes it to the container with --env-file, so every line is NAME=value with no quotes and
# no spaces around the equals sign, and every name starts with HED_LSP_. There is no secret in it.
#
# deploy.sh fixes three settings itself and refuses a file that sets them:
#   HED_LSP_HOST             the image listens on 0.0.0.0 inside the container
#   HED_LSP_PORT             38530, the port that is published on 127.0.0.1
#   HED_LSP_TRUSTED_PROXIES  172.30.56.1, the gateway of the hed-lsp network, which is the address
#                            that Apache's requests arrive from
#
# The values below are the defaults of the daemon (docs/daemon.md, "Limits and settings"), so a fresh
# copy changes nothing. They are listed because the runbook changes them: semantic search in step 15 of
# the deployment, and the recalibration after a measurement.
#
# Changing a value takes effect when the container is recreated: edit this file, then run deploy.sh
# again with the image ID that is running.

# Semantic search: 0 is off, 1 is on. On needs the model cache seeded first and 3g of memory, which
# deploy.sh chooses by itself when this is 1. The image never downloads the model.
HED_LSP_SEMANTIC=0
HED_LSP_MODEL_DOWNLOAD=0

# Threads of the embedding runtime. After a vCPU increase, set it to the whole number of processors the
# container may use, which is its --cpus value rounded down.
HED_LSP_ONNX_THREADS=1

# The general rate limit of each client: units per second and the size of the bucket.
HED_LSP_RATE_ITEMS_PER_SEC=100
HED_LSP_RATE_ITEMS_BURST=1000

# The semantic rate limit of each client, and the queue of semantic requests that wait for the one slot.
HED_LSP_SEMANTIC_RATE_PER_SEC=1
HED_LSP_SEMANTIC_RATE_BURST=20
HED_LSP_SEMANTIC_QUEUE=8

# Requests running at once, all clients together and for one client.
HED_LSP_MAX_IN_FLIGHT=8
HED_LSP_MAX_IN_FLIGHT_PER_CLIENT=4
